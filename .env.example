# ==============================================================================
# EMAILJS CONFIGURATION
# ==============================================================================
# Obtain these values from your EmailJS dashboard: https://dashboard.emailjs.com/
#
# If these variables are not configured or left as placeholders, the contact form
# will automatically fall back to opening the user's default email client via mailto:
# with the name, email, subject, and message prefilled.

# 1. Email Service ID (under Email Services tab)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. Email Template ID (under Email Templates tab)
#    Expected template variables: {{from_name}}, {{from_email}}, {{subject}}, {{message}}
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# 3. Account Public Key (under Account Settings > API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
